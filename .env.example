OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set one key. OpenAI uses gpt-6-luna; Anthropic defaults to claude-sonnet-5-5.
# If both keys are set, choose openai or anthropic explicitly (default: openai).
# CHAT_PROVIDER=anthropic
# Optional Anthropic model override:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# The existing ignored .codex/.secrets/OpenAI_API_Keys.txt also works for OpenAI.
