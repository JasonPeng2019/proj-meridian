# Key-free example. Export this optional variable in your shell before launch.
# Relative paths resolve from development/. Omit it to use ai_settings.yaml.
# Store the server key file in the selected directory; never in this file.
# MERIDIAN_SECRETS_DIR=/absolute/path/to/private/secrets

# Debug is hidden by default. Unset/0 disables it; only 1 enables it.
# Export in the shell; this file is an example, not an automatic dotenv loader.
# MERIDIAN_DEBUG=1
# Optional launch override: uv run meridian --debug (or --no-debug).
# start.sh/start.bat forward the same flags. A03 uses Settings.debug_enabled.
# Ordinary navigation is Chat/Parts; Review and engineering details are in Debug.

# Private chat JSON defaults to development/chat_history/ (excluded from Git).
# Relative overrides resolve from development/; M15 uses Settings.chat_history_dir.
# History reads need no key; full messages/citations/attachments and each thread's
# server-owned tool ledger persist. Luna receives only the selected last 10 turns.
# MERIDIAN_CHAT_HISTORY_DIR=chat_history
